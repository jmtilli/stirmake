@phonyrule: 'BOTHCLEAN///':

@bothcleanhook:
@@	([(["touch", ("bothcleanhookexec")])])

@cleanhook: 'indirection'

$DELEVALTEST=[$TOUCH, @["cleanhookexec"]]

@phonyrule: 'indirection': (@glob('St?rfi*'))
@	$DELEVALTEST<>

$TOUCHFINAL="touch2"

@distcleanhook:
@	$FN<>

$LS=["TORM", "dist"]
$LS += ["hookexec", "TORM"]
$LS=@splice($LS, 3%2, (2*2*2)/2-1)
@if($LS[] != 1+1)
  @call @error("foo\n")
@endif
$FALSY=@true
@function $ERRORS()
  @error("foo\n")
@endfunction
@if(@false && $ERRORS())
  @call @error("foo\n")
@endif
@if(!(@true || $ERRORS()))
  @call @error("foo\n")
@endif
@if(@true)
  $FALSY=@false
@endif
@if($FALSY)
  @call @error("foo\n")
@endif
@if(@false)
  @call @error("foo\n")
@endif
$IMM=@strlistjoin("clean", $LS)
@if($IMM[@] != (5+1)*3-1)
  @call @error("bar\n")
@endif
@if($IMM[@] < 17)
  @call @error("baz\n")
@endif
@if($IMM[@] > 17)
  @call @error("barf\n")
@endif
@if($IMM[@0] != ("d")[@0])
  @call @error("quux\n")
@endif

@function $FN()
  @locvar $TOCONSTRUCT=[]
  @append($TOCONSTRUCT, @D$TOUCHFINAL)
  @appendlist($TOCONSTRUCT, [@I$IMM])
  @appendlist($TOCONSTRUCT, ["cleanhookexec", "bothcleanhookexec"])
  @if(@strcmp($TOCONSTRUCT[-], "bothcleanhookexec") != 0)
    @error("popfail\n")
  @endif
  $TOCONSTRUCT[-] #pop
  @return $TOCONSTRUCT
@endfunction
$IMM=@nil

$TOUCHFINAL="touch"

