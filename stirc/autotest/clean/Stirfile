$JSONESCAPETEST="a\nb\rc\td\\e\x01f\x7f\b\f\"///'"
$JSONESCAPETEST2='a\nb\rc\td\\e\x01f\x7f\b\f"///\''
@if($JSONESCAPETEST[@] != 19)
  @call @error("String escaping error\n")
@endif
@if(@strcmp(@jsondec(@jsonenc($JSONESCAPETEST)), $JSONESCAPETEST2) != 0)
