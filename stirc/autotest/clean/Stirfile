@toplevel
@strict

@phonyrule: 'all': 'bin' @wait 'obj'

@deponly: 'all': 'subdir/../subdir/all/'

@call @adddeps(['all/'], ['subproj/all/'], {})

$TOUCH="false"

$DELEVAL<>=[@strsub("AtouchB", 1, 6), $@]

$CMDDB={@strupper(@strreverse("hc"."uot")): @chomp(@chomp(@strlower("TOUCH\n")))}

$TOUCH=$CMDDB{(@strwordlist("a TOUCH b", " "))[1]}
@if(@strcmp(@strlower("ToUcH"), $TOUCH) != 0)
  @call @error("strcmp\n")
@endif

@distrule: 'bin':
@	@ignore ["false"]
@	@noecho $DELEVAL<>

$SHLIST=["ERR.foo", "OBJ.foo", "OBJ.bar"]
$SHLIST=@prefilterout($SHLIST, "ERR")
$SHLIST=@suffilter($SHLIST, ".foo")
$SHLIST=@sufsuball($SHLIST, ".foo", "")
$SHLIST=@presuball($SHLIST, "OBJ", "bj")
$SHLIST=@presuball($SHLIST, "", "o")
@if($SHLIST[] != @tonumber("1"))
  @call @error("list len err\n")
@endif

@mayberule: 'obj': 'ph' 'ph2'
	$(TOUCH) $(@SHLIST)

@phonyrule: 'ph': 'ph2/.' '/ph3' '/ph4'
@phonyrule: 'ph2///':

@call @addrule({'tgts': [{'name': @strgsub('XXesXXing', 'XX', 't')}], 'attrs': {'phony': !@false}})
$WHOLE=@strstrip("   \t   abc123ABC \t \t\t", " \t")
@call @addrule({'tgts': [{'name': 'testing2'}], 'attrs': {'maybe': (1==@strstr($WHOLE, "123")-2)}})

@phonyrule: 'fails':
@	["false"]

$GLOBTRUE=@true
$GLOBTRUE2=@true
@function $ADDRULES()
  @locvar $tree = {"c": 1, "d": "ERR"}
  @locvar $d = @dictprev($tree, @nil)
  @locvar $mprev = @dictprev({"m": 1, "n": 1}, "n")
  @locvar $m = @dictnext({"l": 1, $mprev: 1}, "l")
  @locvar $CMD=@strword("a ".(@dictnext($tree, @nil)).($m).($d)." b", " ", 1)
  @locvar $TGTS=@strset("tGts", ({"a": 1}){}, ("g")[@0])
  @locvar $AR=["ERR", @["false"], @D$DYNOBJ]
  @locvar $TGTSVAL = [{"name": @dirup . '/' . @dirdown . '/./' . "bin"}]
  @locvar $key = @nil
  @locvar $foridx = @nil
  @locvar $val = @nil
  @locvar $x = \
           {"tgts": @nil, \
            "deps": [{"name": @dirupall . '/testing' . @tostring(@strwordcnt("foo bar", " "))}], \
            "attrs": {"dist": @D$GLOBTRUE}, \
            "shells": [{"cmd": ["false"], "ignore": @true}, {$CMD: ["touch", "bin"]}]}
  $x{"tgts"} = $TGTSVAL
  @fordictprev $key, $val ($tree)
    $x{"tgts2"} = @nil
  @endfor
  @if(!$x{@?"tgts2"})
    @error("foo\n")
  @endif
  @once
    $x{"tgts2"} = -
    @break
    @error("break didnt work\n")
  @endonce
  @if($x{@?"tgts2"})
    @error("foo\n")
  @endif
  @addrule($x)
  @fordictprev $key, $val ($tree)
  @endfor
  @while(@false)
    @error("while loop\n")
  @endwhile
  $AR[$val] = "touch"
  @fordict $key, $val ($tree)
  @endfor
  @for($foridx=1, $foridx<5, $foridx=$foridx+1)
    @continue
  @endfor
  @if($foridx != 5)
    @error("foridx not 5\n")
  @endif
  $foridx=1
  @while($foridx<5)
    $foridx=$foridx+1
  @endwhile
  @if($foridx != 5)
    @error("foridx not 5\n")
  @endif
  @for($foridx=1, $foridx<5, $foridx=$foridx+1)
    @break
  @endfor
  @if($foridx != 1)
    @error("foridx not 1\n")
  @endif
  $AR = @filterout($AR, [$val, "ERR2"])
  @addrule({$TGTS: [{"name": @dirupall . '/' . @dirdownall . '/' . "obj"}], \
            "deps": [{"name": @dirupall . '/./testing'}], \
            "attrs": {"maybe": @L$GLOBTRUE2}, \
            "shells": [{"cmds": [$AR], "embed": @L$GLOBTRUE}]})
@endfunction

# To test if there are clashes
@phonyrule: 'BOTHCLEAN///':

@bothcleanhook:
@@	([(["touch", ("bothcleanhookexec")])])

@cleanhook: 'indirection'

$DELEVALTEST=[$TOUCH, @["cleanhookexec"]]

@phonyrule: 'indirection': 'Stirfile'
@	$DELEVALTEST<>

$TOUCHFINAL="touch2"

@distcleanhook:
@	$FN<>

$LS=["TORM", "dist"]
$LS += ["hookexec", "TORM"]
$LS=@splice($LS, 3%2, (2*2*2)/2-1)
@if($LS[] != 1+1)
  @call @error("foo\n")
@endif
$FALSY=@true
@function $ERRORS()
  @error("foo\n")
@endfunction
@if(@false && $ERRORS())
  @call @error("foo\n")
@endif
@if(!(@true || $ERRORS()))
  @call @error("foo\n")
@endif
@if(@true)
  $FALSY=@false
@endif
@if($FALSY)
  @call @error("foo\n")
@endif
@if(@false)
  @call @error("foo\n")
@endif
$IMM=@strlistjoin("clean", $LS)
@if($IMM[@] != (5+1)*3-1)
  @call @error("bar\n")
@endif
@if($IMM[@] < 17)
  @call @error("baz\n")
@endif
@if($IMM[@] > 17)
  @call @error("barf\n")
@endif
@if($IMM[@0] != ("d")[@0])
  @call @error("quux\n")
@endif

@function $FN()
  @locvar $TOCONSTRUCT=[]
  @append($TOCONSTRUCT, @D$TOUCHFINAL)
  @appendlist($TOCONSTRUCT, [@I$IMM])
  @appendlist($TOCONSTRUCT, ["cleanhookexec", "bothcleanhookexec"])
  $TOCONSTRUCT[-] #pop
  $TOCONSTRUCT[-] #pop
  @return $TOCONSTRUCT
@endfunction
$IMM=@nil

$TOUCHFINAL="touch"

@dirinclude "subdir"
@projdirinclude "subproj"
