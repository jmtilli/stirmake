@subfile
#@strict # to test the parser without strict

$BASE = "statinc3"
$STR = $BASE . '.d.txt'
$LIST = []
$LIST2 = [$STR]
$LIST += [@$LIST2]

@function $MYCHECK()
  @if(@strcmp(@D$@, "all") != 0) # FIXME smkp coredumps if condition reversed
    @error("$@ fail\n")
  @endif
  @if(@strcmp(@D$<, "ph2") != 0)
    @error("$< fail\n")
  @endif
  #@stdout(@jsonenc(@D$^)) # FIXME incorrect string length
  @if(@D$^[] != 4)
    @error("$^ fail\n")
  @endif
  @if(@D$+[] != 5)
    @error("$+ fail\n")
  @endif
  @return []
@endfunction

@phonyrule: 'all': (['ph2']) $LIST '../build/a.txt' 'ph2'
@@	$MYCHECK()

'../build/a.txt': @orderonly (@dirupall . '/build')
	touch $@

(@dirup . '/build'):
	mkdir -p $@

@cdepincludes "statinc.d.txt"
@cdepincludes @ignore "notpresent.d.txt"
@cdepincludes @autophony "statinc2.d.txt"
@cdepincludes @autotarget "statinc3.d.txt"

@phonyrule: '/ph3':

#@distrule: 'bin':
#@	["touch", "bin"]
#
#'obj':
#@	["touch", "obj"]
$DYNOBJ="obj"
$GLOBTRUE2=@false
@call $ADDRULES()

# To test if there are clashes
@phonyrule: 'CLEAN///':

@bothcleanhook:
@	["touch", "bothcleanhookexec"]

@cleanhook:
@	["touch", "cleanhookexec"]

@distcleanhook:
@	["touch", "distcleanhookexec"]
