@subfile
#@strict # to test the parser without strict

$BASE = "statinc3"
$STR = $BASE . '.d.txt'
$LIST = []
$LIST2 = [$STR]
$LIST += [@$LIST2]

@function $MYCHECK()
  @locvar $exphat = [ \
    "ph2", \
    "statinc3.d.txt", \
    "../build/a.txt", \
    "obj" ]
  @locvar $expplus = [ \
    "ph2", \
    "statinc3.d.txt", \
    "../build/a.txt", \
    "ph2", \
    "obj" ]
  @if(@strcmp(@D$@, "all") != 0)
    @error("$@ fail\n")
  @endif
  @if(@strcmp(@D$<, "ph2") != 0)
    @error("$< fail\n")
  @endif
  @if(@D$^[] != 4)
    @error("$^ fail\n")
  @endif
  @if(@D$+[] != 5)
    @error("$+ fail\n")
  @endif
  @if(@strcmp(@jsonenc($exphat), @jsonenc(@D$^)) != 0)
    @error("$^ fail\n")
  @endif
  @if(@strcmp(@jsonenc($expplus), @jsonenc(@D$+)) != 0)
    @error("$+ fail\n")
  @endif
  @if(@strcmp(@dirup, "..") != 0)
    @error("@dirup fail")
  @endif
  @if(@strcmp(@dirupall, "..") != 0)
    @error("@dirupall fail")
  @endif
  @if(@strcmp(@dirdown, "subdir") != 0)
    @error("@dirdown fail")
  @endif
  @if(@strcmp(@dirdownall, "subdir") != 0)
    @error("@dirdownall fail")
  @endif
  @return []
@endfunction

@phonyrule: 'all': (['ph2']) $LIST '../build/a.txt' 'ph2'
@@	$MYCHECK()

@function $MYCHECK2()
  @locvar $exporderonly = [@dirupall . '/build']
  @if(@D$^[] != 0)
    @error("$^ fail\n")
  @endif
  @if(@D$+[] != 0)
    @error("$+ fail\n")
  @endif
  @if(@strcmp(@jsonenc($exporderonly), @jsonenc(@D$|)) != 0)
    @error("$| fail\n")
  @endif
  @return []
@endfunction

'../build/a.txt': @orderonly (@dirupall . '/build')
@@	$MYCHECK2()
	touch $@

(@dirup . '/build'):
	mkdir -p $@

@cdepincludes "statinc.d.txt"
@cdepincludes @ignore "notpresent.d.txt"
@cdepincludes @autophony "statinc2.d.txt"
@cdepincludes @autotarget "statinc3.d.txt"

@phonyrule: '/ph3':

#@distrule: 'bin':
#@	["touch", "bin"]
#
#'obj':
#@	["touch", "obj"]
$DYNOBJ="obj"
$GLOBTRUE2=@false
@call $ADDRULES()

# To test if there are clashes
@phonyrule: 'CLEAN///':

@bothcleanhook:
@	["touch", "bothcleanhookexec"]

@cleanhook:
@	["touch", "cleanhookexec"]

@distcleanhook:
@	["touch", "distcleanhookexec"]
