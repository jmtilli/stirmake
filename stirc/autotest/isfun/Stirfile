@toplevel
@strict

@phonyrule: 'all': 'obj' 'bin'
@phonyrule: 'testing':
@phonyrule: 'testing2':

@function $RETARG($arg)
  @return $arg
@endfunction

@function $ADDRULES()
  @locvar $tree = {"c": 1, "d": "ERR"}
  @locvar $d = @dictprev($tree, @nil)
  @locvar $mprev = @dictprev({"m": 1, "n": 1}, "n")
  @locvar $m = @dictnext({"l": 1, $mprev: 1}, "l")
  @locvar $CMD=@strword("a ".(@dictnext($tree, @nil)).($m).($d)." b", " ", 1)
  @locvar $TGTS=@strset("tGts", ({"a": 1}){}, ("g")[@0])
  @locvar $AR=["ERR", @["false"], 'obj']
  @locvar $TGTSVAL = [{"name": @dirup . '/' . @dirdown . '/./' . "bin"}]
  @locvar $x = \
           {"tgts": @nil, \
            "deps": [{"name": @dirupall . '/testing' . @tostring(@strwordcnt("foo bar", " "))}], \
            "attrs": {"dist": @true}, \
            "shells": [{"arg": ["false"], "isfun": @true, "ignore": @true, "fun": @L$RETARG}, {"arg": ["touch", "bin"], "isfun": @true, "fun": @L$RETARG}]}
  $x{"tgts"} = $TGTSVAL
  @addrule($x)
  $AR[1] = "touch"
  $AR = @filterout($AR, ["ERR", "ERR2"])
  @addrule({$TGTS: [{"name": @dirupall . '/' . @dirdownall . '/' . "obj"}], \
            "deps": [{"name": @dirupall . '/./testing'}], \
            "attrs": {"maybe": @true}, \
            "shells": [{"arg": [$AR], "isfun": @true, "embed": @true, "fun": @L$RETARG}]})
@endfunction

@call $ADDRULES()
